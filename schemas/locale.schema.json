{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imboy-pub.github.io/geo_regions/schemas/locale.schema.json",
  "title": "geo_regions locale v1.0",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": "1.0"
    },
    "datasetId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "pattern": "^[sclm]-[a-f0-9]{16}$"
    },
    "coverage": {
      "type": "object"
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "countryCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 255
    },
    "compatibleStructureRevision": {
      "type": "string",
      "pattern": "^s-[a-f0-9]{16}$"
    },
    "names": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "protocolVersion",
    "datasetId",
    "revision",
    "countryCode",
    "locale",
    "compatibleStructureRevision",
    "names"
  ],
  "additionalProperties": false
}
